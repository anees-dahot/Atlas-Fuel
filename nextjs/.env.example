# Sanity Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_api_token
SANITY_API_READ_TOKEN=your_api_token

# Preview/Draft Mode
SANITY_PREVIEW_SECRET=your-preview-secret

# Visual Editing
NEXT_PUBLIC_SANITY_STEGA_ENABLED=true
NEXT_PUBLIC_SANITY_STUDIO_URL=https://your-studio.sanity.studio

# Webhook Secret for Instant Cache Updates
SANITY_REVALIDATE_SECRET=your-webhook-secret-here

# Website Forms (Resend)
RESEND_API_KEY=re_your_api_key
ATLAS_FORMS_FROM_EMAIL=Atlas Fuel Website <website@your-verified-domain.com>
ATLAS_FORMS_TO_EMAIL=info@atlasfuel.com.au
